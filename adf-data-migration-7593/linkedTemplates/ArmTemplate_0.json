		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datamigrationadftofabric.dfs.core.windows.net/"
		},
		"AzureSynapseAnalytics1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "transportationmigration.sql.azuresynapse.net"
		},
		"AzureSynapseAnalytics1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "transportationdedicated"
		},
		"AzureSynapseAnalytics1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "transportationmk"
		},
		"Sathvik_ADF_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datamigrationadftofabric.dfs.core.windows.net/"
