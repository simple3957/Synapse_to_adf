		"Sathvik_ADF_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Sathvik_ADF'"
		},
		"transportationsynapsemigration-WorkspaceDefaultSqlServer_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'transportationsynapsemigration-WorkspaceDefaultSqlServer'"
		},
		"LS_Synapse_Workspace_properties_typeProperties_endpoint": {
			"type": "string",
			"defaultValue": "https://workspacecr.dev.azuresynapse.net"
		},
		"transportationsynapsemigration-WorkspaceDefaultStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfteststoragebhavana.dfs.core.windows.net/"
